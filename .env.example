# X-Ray environment configuration
# Copy this file to .env and adjust values as needed.

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Environment mode: development (embed raw assets) or production (minified)
ENV=development

# AI analysis (OpenAI-compatible API)
# Uncomment and set your API key to enable AI analysis of FTDC charts
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o

# MongoDB connection (used by healthcheck)
# MONGODB_URI=mongodb://localhost:27017/admin?tls=false
